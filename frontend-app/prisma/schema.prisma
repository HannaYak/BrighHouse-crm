datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  NEW
  PROCESSING
  SELECTING
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  NORMAL
  TODAY
  URGENT
  CONFIRMED
}

enum ServiceType {
  STANDARD
  STANDARD_PLUS
  GENERAL
  AFTER_REPAIR
}

model Client {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String   @unique
  address          String
  notes            String?
  favoriteCleaner  String?
  blacklistCleaner String?
  orders           Order[]
  createdAt        DateTime @default(now())
}

model Cleaner {
  id               Int            @id @default(autoincrement())
  name             String
  phone            String         @unique
  telegramHandle   String?
  district         String         @default("Центр")
  telegramChatId   String?        @unique
  authCode         String?        @unique
  calendarEmail    String?
  tags             String[]
  incompatibleWith String[]
  status           String         @default("active")
  assignments      OrderCleaner[]
  createdAt        DateTime       @default(now())
}

model ServiceTariff {
  id               Int         @id @default(autoincrement())
  type             ServiceType
  roomsCount       Int
  bathroomsCount   Int         @default(1)
  maxAreaM2        Int
  price            Float
  baseDurationMins Int
}

model AddOnService {
  id               Int     @id @default(autoincrement())
  code             String  @unique
  title            String
  price            Float
  durationMins     Int
  unit             String  @default("шт")
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  date              DateTime
  timeSlot          String
  serviceType       ServiceType    @default(STANDARD)
  areaM2            Int            @default(45)
  roomsCount        Int            @default(1)
  bathroomsCount    Int            @default(1)
  windowsCount      Int            @default(0)
  
  // Дополнительные опции уборки
  hasOven           Boolean        @default(false)
  hasFridge         Boolean        @default(false)
  hasFridgeFreeze   Boolean        @default(false)
  hasMicrowave      Boolean        @default(false)
  hasBalcony        Boolean        @default(false)
  hasKitchenClosets Boolean        @default(false)
  hasStairs         Boolean        @default(false)
  hasSteamer        Boolean        @default(false)
  hasDishes         Boolean        @default(false)
  hasIroning        Boolean        @default(false)
  hasVacuum         Boolean        @default(false)
  hasPets           Boolean        @default(false)
  hasKeys           Boolean        @default(false)

  clientName        String
  clientPhone       String
  addressLine1      String
  addressLine2      String?
  latitude          Float?
  longitude         Float?
  price             Float
  cleanersCount     Int            @default(1)
  notes             String?
  cancelReason      String?
  urgency           UrgencyLevel   @default(NORMAL)
  status            OrderStatus    @default(NEW)
  clientId          Int?
  client            Client?        @relation(fields: [clientId], references: [id])
  assignedCleaners  OrderCleaner[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model OrderCleaner {
  orderId    String
  cleanerId  Int
  isAccepted Boolean @default(false)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cleaner    Cleaner @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@id([orderId, cleanerId])
}
