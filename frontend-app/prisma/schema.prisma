datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  NEW
  PROCESSING
  SELECTING
  ASSIGNED
  COMPLETED
  CANCELLED
}

enum UrgencyLevel {
  NORMAL
  TODAY
  URGENT
  CONFIRMED
}

enum ServiceType {
  STANDARD
  STANDARD_PLUS
  GENERAL
  AFTER_REPAIR
}

model Client {
  id               Int      @id @default(autoincrement())
  name             String
  phone            String   @unique
  address          String
  notes            String?
  favoriteCleaner  String?
  blacklistCleaner String?
  orders           Order[]
  createdAt        DateTime @default(now())
}

model Cleaner {
  id               Int            @id @default(autoincrement())
  name             String
  phone            String         @unique
  telegramHandle   String?
  district         String         @default("Центр")
  telegramChatId   String?        @unique
  authCode         String?        @unique
  calendarEmail    String?
  tags             String[]
  incompatibleWith String[]
  status           String         @default("active")
  assignments      OrderCleaner[]
  createdAt        DateTime       @default(now())
}

model ServiceTariff {
  id               Int         @id @default(autoincrement())
  type             ServiceType
  roomsCount       Int
  bathroomsCount   Int         @default(1)
  maxAreaM2        Int
  price            Float
  baseDurationMins Int
}

model AddOnService {
  id               Int     @id @default(autoincrement())
  code             String  @unique
  title            String
  price            Float
  durationMins     Int
  unit             String  @default("шт")
}

model Order {
  id                String         @id @default(cuid())
  orderNumber       String         @unique
  date              DateTime
  timeSlot          String
  serviceType       ServiceType    @default(STANDARD)
  areaM2            Int            @default(45)
  roomsCount        Int            @default(1)
  bathroomsCount    Int            @default(1)
  windowsCount      Int            @default(0)
  
  // Дополнительные опции уборки
  hasOven           Boolean        @default(false)
  hasFridge         Boolean        @default(false)
  hasFridgeFreeze   Boolean        @default(false)
  hasMicrowave      Boolean        @default(false)
  hasBalcony        Boolean        @default(false)
  hasKitchenClosets Boolean        @default(false)
  hasStairs         Boolean        @default(false)
  hasSteamer        Boolean        @default(false)
  hasDishes         Boolean        @default(false)
  hasIroning        Boolean        @default(false)
  hasVacuum         Boolean        @default(false)
  hasPets           Boolean        @default(false)
  hasKeys           Boolean        @default(false)

  clientName        String
  clientPhone       String
  addressLine1      String
  addressLine2      String?
  latitude          Float?
  longitude         Float?
  price             Float
  cleanersCount     Int            @default(1)
  notes             String?
  cancelReason      String?
  urgency           UrgencyLevel   @default(NORMAL)
  status            OrderStatus    @default(NEW)
  clientId          Int?
  client            Client?        @relation(fields: [clientId], references: [id])
  assignedCleaners  OrderCleaner[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model OrderCleaner {
  orderId    String
  cleanerId  Int
  isAccepted Boolean @default(false)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cleaner    Cleaner @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@id([orderId, cleanerId])
}

// Модель диалога с клиентом
model Conversation {
    id        String    @id @default(uuid())
    channel   String    // 'TELEGRAM', 'WHATSAPP', 'INSTAGRAM'
    externalId String   @unique // ID чата в мессенджере (например, chat_id в Telegram)
    clientName String?  // Имя клиента в мессенджере
    phone     String?   // Телефон, если удалось определить
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    
    messages  Message[]
}

// Модель отдельного сообщения
model Message {
    id             String       @id @default(uuid())
    conversationId String
    conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    senderType     String       // 'CLIENT' или 'MANAGER'
    text           String       // Текст сообщения
    createdAt      DateTime     @default(now())
}


model PromoCode {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  description String?
  discountType String   // "PERCENT" или "FIXED"
  value       Float     // процент (например 10) или фикс. сумма в zł (например 30)
  minOrderSum Float?    @default(0)
  maxUses     Int?      // максимальное кол-во использований (null = безлимит)
  usedCount   Int       @default(0)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model CompanySettings {
  id              Int      @id @default(1)
  companyName     String   @default("BrightHouse Cleaning")
  nip             String?  @default("")
  phone           String?  @default("")
  email           String?  @default("")
  city            String?  @default("Warszawa")
  address         String?  @default("")
  instagram       String?  @default("@brighthouse.pl")
  
  // Банковские реквизиты для клиентов
  bankName        String?  @default("Santander / mBank")
  accountNumber   String?  @default("") // IBAN
  blikPhone       String?  @default("") // Номер для перевода BLIK на телефон
  recipientName   String?  @default("")

  // Проценты выплат клинерам
  cleanerRatePercent Float @default(40.0) // Ставка клинера (% от заказа по умолчанию)

  updatedAt       DateTime @updatedAt
}

enum InventoryCategory {
  CHEMISTRY     // Профессиональная химия
  CONSUMABLE    // Расходники (губки, салфетки, перчатки)
  EQUIPMENT     // Оборудование (пылесосы, пароочистители)
  UNIFORM       // Форма / инвентарь
}

model InventoryItem {
  id          String            @id @default(cuid())
  name        String
  category    InventoryCategory @default(CHEMISTRY)
  quantity    Int               @default(0)
  minQuantity Int               @default(5)       // Порог предупреждения об остатке
  unit        String            @default("шт")     // шт, л, уп
  location    String?           @default("Главный склад")
  assignedTo  String?                              // Имя клинера, если техника на руках
  notes       String?
  updatedAt   DateTime          @updatedAt
  createdAt   DateTime          @default(now())
}

model OrderCleaner {
  orderId      String
  cleanerId    Int
  isAccepted   Boolean @default(false)
  reminderSent Boolean @default(false) // <--- Добавляем флаг
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cleaner      Cleaner @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@id([orderId, cleanerId])
}
